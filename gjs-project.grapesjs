w Header","classes":["quick-view-header"],"components":[{"tagName":"h4","type":"heading","name":"Quick View Title","classes":["quick-view-title"],"attributes":{"id":"quickViewTitle"},"components":[{"type":"textnode","content":"Quick View"}]},{"type":"button","name":"Quick View Close","classes":["quick-view-close"],"attributes":{"type":"button","aria-label":"Close quick view","id":"quickViewClose"},"components":[{"type":"contentEditable","components":[{"type":"image","name":"Close Icon","resizable":{"ratioDefault":1},"classes":["close-icon"],"attributes":{"src":"https://api.iconify.design/lucide-x.svg?color=%23e5e7eb","alt":"Close Icon"}}]}]}]},{"name":"Quick View Content","classes":["quick-view-content"],"components":[{"name":"Quick View Image Wrapper","classes":["quick-view-image-wrapper"],"components":[{"type":"image","name":"Quick View Image","resizable":{"ratioDefault":1},"classes":["quick-view-image"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=%22luxury%20coat%22&w=700&h=600","alt":"Quick View Product","id":"quickViewImage"}}]},{"name":"Quick View Info","classes":["quick-view-info"],"components":[{"tagName":"h5","type":"heading","name":"Quick View Name","classes":["quick-view-name"],"attributes":{"id":"quickViewName"},"components":[{"type":"textnode","content":"Emerald Double-Breasted Coat"}]},{"tagName":"span","type":"text","name":"Quick View Price","classes":["quick-view-price"],"attributes":{"id":"quickViewPrice"},"components":[{"type":"textnode","content":"$1,480"}]},{"tagName":"p","type":"text","name":"Quick View Description","classes":["quick-view-description"],"components":[{"type":"textnode","content":"A sharply tailored coat with velvet collar and horn buttons."}]},{"type":"button","name":"Quick View Add Cart","classes":["gjs-t-button","quick-view-add-cart"],"attributes":{"type":"button"},"components":[{"type":"contentEditable","components":[{"type":"textnode","content":"Add to Cart"}]}]}]}]}]}]},{"name":"Size Guide Modal Backdrop","classes":["size-guide-modal-backdrop"],"attributes":{"id":"sizeGuideBackdrop","role":"dialog","aria-modal":"true","aria-labelledby":"sizeGuideTitle"},"components":[{"name":"Size Guide Modal","classes":["size-guide-modal"],"components":[{"name":"Size Guide Header","classes":["size-guide-header"],"components":[{"tagName":"h4","type":"heading","name":"Size Guide Title","classes":["size-guide-title"],"attributes":{"id":"sizeGuideTitle"},"components":[{"type":"textnode","content":"Size Guide"}]},{"type":"button","name":"Size Guide Close","classes":["size-guide-close"],"attributes":{"type":"button","aria-label":"Close size guide","id":"sizeGuideClose"},"components":[{"type":"contentEditable","components":[{"type":"image","name":"Close Icon","resizable":{"ratioDefault":1},"classes":["close-icon"],"attributes":{"src":"https://api.iconify.design/lucide-x.svg?color=%23e5e7eb","alt":"Close Icon"}}]}]}]},{"name":"Size Guide Content","classes":["size-guide-content"],"components":[{"tagName":"p","type":"text","name":"Size Guide Intro","classes":["size-guide-intro"],"components":[{"type":"textnode","content":"Measure your bust, waist, and hips. Compare with the chart to select the best size."}]},{"name":"Size Chart Grid","classes":["size-chart-grid"],"components":[{"name":"Size Chart Item","classes":["size-chart-item"],"components":[{"tagName":"span","type":"text","name":"Size Chart Label","classes":["size-chart-label"],"components":[{"type":"textnode","content":"XS"}]},{"tagName":"p","type":"text","name":"Size Chart Detail","classes":["size-chart-detail"],"components":[{"type":"textnode","content":"Bust 80-84 • Waist 62-66 • Hips 86-90"}]}]},{"name":"Size Chart Item","classes":["size-chart-item"],"components":[{"tagName":"span","type":"text","name":"Size Chart Label","classes":["size-chart-label"],"components":[{"type":"textnode","content":"S"}]},{"tagName":"p","type":"text","name":"Size Chart Detail","classes":["size-chart-detail"],"components":[{"type":"textnode","content":"Bust 84-88 • Waist 66-70 • Hips 90-94"}]}]},{"name":"Size Chart Item","classes":["size-chart-item"],"components":[{"tagName":"span","type":"text","name":"Size Chart Label","classes":["size-chart-label"],"components":[{"type":"textnode","content":"M"}]},{"tagName":"p","type":"text","name":"Size Chart Detail","classes":["size-chart-detail"],"components":[{"type":"textnode","content":"Bust 88-92 • Waist 70-74 • Hips 94-98"}]}]},{"name":"Size Chart Item","classes":["size-chart-item"],"components":[{"tagName":"span","type":"text","name":"Size Chart Label","classes":["size-chart-label"],"components":[{"type":"textnode","content":"L"}]},{"tagName":"p","type":"text","name":"Size Chart Detail","classes":["size-chart-detail"],"components":[{"type":"textnode","content":"Bust 92-96 • Waist 74-78 • Hips 98-102"}]}]},{"name":"Size Chart Item","classes":["size-chart-item"],"components":[{"tagName":"span","type":"text","name":"Size Chart Label","classes":["size-chart-label"],"components":[{"type":"textnode","content":"XL"}]},{"tagName":"p","type":"text","name":"Size Chart Detail","classes":["size-chart-detail"],"components":[{"type":"textnode","content":"Bust 96-100 • Waist 78-82 • Hips 102-106"}]}]}]}]}]}]},{"type":"script","name":"Interactive Script","components":[{"type":"textnode","content":"\n  (function(){\n    var slidesWrapper = document.getElementById('slidesWrapper');\n    var slides = slidesWrapper ? slidesWrapper.children : [];\n    var current = 0;\n    function showSlide(index){\n      for(var i=0;i<slides.length;i++){\n        slides[i].style.opacity = i===index ? '1' : '0';\n        slides[i].style.zIndex = i===index ? '1' : '0';\n      }\n      current = index;\n    }\n    function next(){\n      showSlide((current+1)%slides.length);\n    }\n    function prev(){\n      showSlide((current-1+slides.length)%slides.length);\n    }\n    var nextBtn = document.getElementById('nextSlide');\n    var prevBtn = document.getElementById('prevSlide');\n    if(nextBtn) nextBtn.addEventListener('click', next);\n    if(prevBtn) prevBtn.addEventListener('click', prev);\n    var auto = setInterval(next, 6000);\n\n    var menuToggle = document.getElementById('menuToggle');\n    var mobileMenu = document.getElementById('mobileMenu');\n    if(menuToggle && mobileMenu){\n      menuToggle.addEventListener('click', function(){\n        var visible = mobileMenu.classList.contains('hidden');\n        mobileMenu.classList.toggle('hidden', !visible);\n        mobileMenu.classList.toggle('block', visible);\n      });\n    }\n\n    var quickViewBackdrop = document.getElementById('quickViewBackdrop');\n    var quickViewClose = document.getElementById('quickViewClose');\n    var quickViewImage = document.getElementById('quickViewImage');\n    var quickViewName = document.getElementById('quickViewName');\n    var quickViewPrice = document.getElementById('quickViewPrice');\n    function openQuickView(img, name, price){\n      if(quickViewImage) quickViewImage.src = img;\n      if(quickViewName) quickViewName.textContent = name;\n      if(quickViewPrice) quickViewPrice.textContent = price;\n      if(quickViewBackdrop){\n        quickViewBackdrop.classList.remove('hidden');\n        quickViewBackdrop.classList.add('flex');\n      }\n    }\n    function closeQuickView(){\n      if(quickViewBackdrop){\n        quickViewBackdrop.classList.add('hidden');\n        quickViewBackdrop.classList.remove('flex');\n      }\n    }\n    document.querySelectorAll('[data-quick-view]').forEach(function(btn){\n      btn.addEventListener('click', function(){\n        var card = btn.closest('[data-gjs-name=\"Product Card\"]');\n        var imgEl = card ? card.querySelector('[data-gjs-name=\"Product Image\"]') : null;\n        var nameEl = card ? card.querySelector('[data-gjs-name=\"Product Name\"]') : null;\n        var priceEl = card ? card.querySelector('[data-gjs-name=\"Product Price\"]') : null;\n        openQuickView(imgEl ? imgEl.src : '', nameEl ? nameEl.textContent : 'Product', priceEl ? priceEl.textContent : '$0');\n      });\n    });\n    if(quickViewClose) quickViewClose.addEventListener('click', closeQuickView);\n    if(quickViewBackdrop) quickViewBackdrop.addEventListener('click', function(e){ if(e.target===quickViewBackdrop) closeQuickView(); });\n\n    var sizeGuideBackdrop = document.getElementById('sizeGuideBackdrop');\n    var sizeGuideOpen = document.getElementById('sizeGuideOpen');\n    var sizeGuideClose = document.getElementById('sizeGuideClose');\n    function openSizeGuide(){\n      if(sizeGuideBackdrop){\n        sizeGuideBackdrop.classList.remove('hidden');\n        sizeGuideBackdrop.classList.add('flex');\n      }\n    }\n    function closeSizeGuide(){\n      if(sizeGuideBackdrop){\n        sizeGuideBackdrop.classList.add('hidden');\n        sizeGuideBackdrop.classList.remove('flex');\n      }\n    }\n    if(sizeGuideOpen) sizeGuideOpen.addEventListener('click', openSizeGuide);\n    if(sizeGuideClose) sizeGuideClose.addEventListener('click', closeSizeGuide);\n    if(sizeGuideBackdrop) sizeGuideBackdrop.addEventListener('click', function(e){ if(e.target===sizeGuideBackdrop) closeSizeGuide(); });\n\n    var pdMainImage = document.getElementById('pdMainImage');\n    if(pdMainImage){\n      pdMainImage.style.transition = 'transform 0.2s ease';\n      pdMainImage.addEventListener('mousemove', function(e){\n        var rect = pdMainImage.getBoundingClientRect();\n        var x = ((e.clientX - rect.left) / rect.width - 0.5) * 4;\n        var y = ((e.clientY - rect.top) / rect.height - 0.5) * 4;\n        pdMainImage.style.transform = 'scale(1.08) translate(' + (-x*5) + 'px,' + (-y*5) + 'px)';\n      });\n      pdMainImage.addEventListener('mouseleave', function(){\n        pdMainImage.style.transform = 'scale(1) translate(0,0)';\n      });\n    }\n    document.querySelectorAll('[data-thumb]').forEach(function(btn){\n      btn.addEventListener('click', function(){\n        var src = btn.getAttribute('data-thumb');\n        if(pdMainImage && src) pdMainImage.src = src;\n      });\n    });\n  })();\n  "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","name":"Meta Charset","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","name":"Meta Viewport","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1"}},{"tagName":"title","type":"text","name":"Document Title","components":[{"type":"textnode","content":"Maison Élégance — Luxury Clothing Designs"}]},{"tagName":"link","name":"Google Fonts","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;600;700&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"JdQHfxYgBEQGoBlR","minHeight":"500px"}],"id":"WMVCw45Cu21gRY7p"}],"symbols":[],"custom":{"projectType":"web","id":""}}